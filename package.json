{
  "type": "wordpress-site-package",
  "version": "2.1.0",
  "site": "touchgrass",
  "theme": "touchgrass",
  "corePlugin": "touchgrass-core",
  "requires": {
    "wordpress": ">=6.5",
    "php": ">=8.1",
    "woocommerce": ">=9.0"
  },
  "features": {
    "woocommerce": true,
    "demoContent": true,
    "checkoutBlocks": true,
    "classicCheckout": true,
